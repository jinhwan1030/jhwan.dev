[Unit]
Description=Boot and verify the latest jhwan.dev content backup in isolation
Requires=docker.service
After=docker.service jhwan-homepage-backup.service

[Service]
Type=oneshot
User=__DEPLOY_USER__
Group=docker
Environment=JHWAN_HOMEPAGE_BACKUP_ROOT=__BACKUP_ROOT__
Environment=JHWAN_HOMEPAGE_REHEARSAL_ROOT=__REHEARSAL_ROOT__
Environment=JHWAN_HOMEPAGE_REHEARSAL_LOCK_WAIT_SECONDS=600
ExecStart=/usr/local/sbin/jhwan-homepage-restore-rehearsal
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__REHEARSAL_ROOT__ /run/lock

[Install]
WantedBy=multi-user.target
